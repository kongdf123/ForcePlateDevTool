<Window x:Class="ForcePlateDevTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ForcePlateDevTool.Controls"
        Title="KWFS02 起跑器诊断工具"
        Height="800" Width="1280"
        MinHeight="680" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F9"
        FontFamily="Microsoft YaHei UI"
        FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DCE2EA"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#64748B"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>

        <Style TargetType="{x:Type GroupBox}">
            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="{x:Type Button}"
               BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Padding" Value="5,4"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="StageCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="StageStatus" TargetType="{x:Type TextBlock}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="Margin" Value="0,5,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="KWFS02 起跑器诊断工具"
                           FontSize="22" FontWeight="Bold"
                           Foreground="#172033"/>
                <TextBlock Text="设备连接 · 数据接收 · 帧解析 · 力值解码"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <TextBlock Text="连接状态"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtStatus"
                           Text="未就绪"
                           FontWeight="SemiBold"
                           Foreground="#64748B"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Connection settings and primary actions -->
        <GroupBox Grid.Row="1" Header="设备与连接">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,18,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0"
                               Text="设备 IP" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="1"
                             x:Name="TxtRemoteIP" Text="192.168.1.25"
                             Margin="0,0,14,8"/>

                    <TextBlock Grid.Row="0" Grid.Column="2"
                               Text="设备端口" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="0" Grid.Column="3"
                             x:Name="TxtRemotePort" Text="5152"
                             Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0"
                               Text="本地 IP" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             x:Name="TxtLocalIP" Text="192.168.1.100"
                             Margin="0,0,14,8"/>

                    <TextBlock Grid.Row="1" Grid.Column="2"
                               Text="本地端口" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Row="1" Grid.Column="3"
                             x:Name="TxtLocalPort" Text="8886"
                             Margin="0,0,0,8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0"
                               Text="采集模式" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3"
                              x:Name="CmbMode" SelectedIndex="1">
                        <ComboBoxItem Content="主动获取 (49)"/>
                        <ComboBoxItem Content="被动接收 (48)"/>
                        <ComboBoxItem Content="仅外部触发 (58)"/>
                    </ComboBox>
                </Grid>

                <Grid Grid.Column="1" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnPing"
                            Grid.Column="0"
                            Content="网络检测"
                            Click="BtnPing_Click"/>
                    <Button x:Name="BtnConnect"
                            Grid.Column="1"
                            Content="连接设备"
                            Style="{StaticResource PrimaryButton}"
                            Click="BtnConnect_Click"/>
                    <Button x:Name="BtnDisconnect"
                            Grid.Column="2"
                            Content="断开"
                            Click="BtnDisconnect_Click"
                            Margin="0"/>
                    <TextBlock Grid.Column="3"
                               Text="一键诊断与报告导出可在后续版本接入"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               FontSize="11"/>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Pipeline status -->
        <GroupBox Grid.Row="2" Header="诊断链路">
            <UniformGrid Columns="6">
                <Border Style="{StaticResource StageCard}">
                    <StackPanel>
                        <TextBlock Text="01  网络可达" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtNetworkStageStatus"
                                   Text="待检测" Style="{StaticResource StageStatus}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StageCard}">
                    <StackPanel>
                        <TextBlock Text="02  UDP Socket" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtUdpStageStatus"
                                   Text="未就绪" Style="{StaticResource StageStatus}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StageCard}">
                    <StackPanel>
                        <TextBlock Text="03  指令交互" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtCommandStageStatus"
                                   Text="待验证" Style="{StaticResource StageStatus}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StageCard}">
                    <StackPanel>
                        <TextBlock Text="04  数据接收" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtReceiveStageStatus"
                                   Text="等待数据" Style="{StaticResource StageStatus}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StageCard}">
                    <StackPanel>
                        <TextBlock Text="05  帧解析" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtParseStageStatus"
                                   Text="等待帧" Style="{StaticResource StageStatus}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StageCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="06  力值解码" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtDecodeStageStatus"
                                   Text="等待解码" Style="{StaticResource StageStatus}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
        </GroupBox>

        <!-- Main workspace -->
        <TabControl Grid.Row="3" Margin="0,0,0,8">

            <TabItem Header="解码帧与力值">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="TxtFrameHeader"
                                   Text="等待帧..."
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"/>
                        <Button x:Name="BtnClearFrames"
                                Content="清空帧"
                                Click="BtnClearFrames_Click"
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              x:Name="DgFrames"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              FontFamily="Consolas"
                              FontSize="12"
                              RowHeaderWidth="0"
                              EnableRowVirtualization="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="帧序号" Binding="{Binding FrameSeq}" Width="70"/>
                            <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="60"/>
                            <DataGridTextColumn Header="踏板" Binding="{Binding Pedal}" Width="75"/>
                            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="130"/>
                            <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="65"/>
                            <DataGridTextColumn Header="Fx" Binding="{Binding Fx}" Width="100"/>
                            <DataGridTextColumn Header="Fy" Binding="{Binding Fy}" Width="100"/>
                            <DataGridTextColumn Header="Fz" Binding="{Binding Fz}" Width="100"/>
                            <DataGridTextColumn Header="原始浮点数据" Binding="{Binding RawFloats}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="原始字节流">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="TxtRawHeader"
                                   Text="等待数据..."
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <Button x:Name="BtnClearRaw"
                                Content="清空字节流"
                                Click="BtnClearRaw_Click"
                                DockPanel.Dock="Right"
                                Margin="8,0,0,0"/>
                    </DockPanel>

                    <TextBox Grid.Row="1"
                             x:Name="TxtRawStream"
                             IsReadOnly="True"
                             FontFamily="Consolas"
                             FontSize="12"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             AcceptsReturn="True"/>
                </Grid>
            </TabItem>

            <TabItem Header="采集与高级指令">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="常用采集操作"
                               FontSize="15" FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,18">
                        <Button x:Name="BtnStart"
                                Content="开始采集"
                                Style="{StaticResource PrimaryButton}"
                                Click="BtnStart_Click"/>
                        <Button x:Name="BtnStop"
                                Content="停止采集"
                                Click="BtnStop_Click"/>
                        <Button x:Name="BtnStartReceive"
                                Content="仅接收"
                                Click="BtnStartReceive_Click"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2"
                               Text="低层指令（高级调试）"
                               FontSize="15" FontWeight="SemiBold"
                               Margin="0,0,0,10"/>

                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="CmbPresetCmd"
                                  Grid.Column="0"
                                  SelectedIndex="0"
                                  SelectionChanged="CmbPresetCmd_SelectionChanged"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Top"
                                  ToolTip="选择预设指令">
                            <ComboBoxItem Content="开始采集 (48)" Tag="48 AA 0D 0A"/>
                            <ComboBoxItem Content="停止采集 (43)" Tag="43 AA 0D 0A"/>
                            <ComboBoxItem Content="主动轮询 (49)" Tag="49 AA 0D 0A"/>
                            <ComboBoxItem Content="仅外部触发 (58)" Tag="58 AA 0D 0A"/>
                            <ComboBoxItem Content="停止（长帧）"
                                          Tag="48 AA 00 00 00 00 00 00 00 00 00 00 00 0D 0A"/>
                        </ComboBox>

                        <TextBox x:Name="TxtRawCmd"
                                 Grid.Column="1"
                                 Margin="0,0,8,0"
                                 Text="48 AA 0D 0A"
                                 VerticalAlignment="Top"/>

                        <Button x:Name="BtnSendRaw"
                                Grid.Column="2"
                                Content="发送 HEX"
                                Click="BtnSendRaw_Click"
                                VerticalAlignment="Top"/>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="实时力值趋势">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="左踏板 (0xAA)"
                              Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <controls:ForceTrendChart
                                x:Name="LeftForceChart" />

                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Fx"
                                           Foreground="#2563EB" />
                                <TextBlock x:Name="TxtLeftFx"
                                           Text="—"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="Fy"
                                           Foreground="#D97706" />
                                <TextBlock x:Name="TxtLeftFy"
                                           Text="—"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="Fz"
                                           Foreground="#059669" />
                                <TextBlock x:Name="TxtLeftFz"
                                           Text="—"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="右踏板 (0xAB)"
                              Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                            </Grid.ColumnDefinitions>

                            <controls:ForceTrendChart
                                x:Name="RightForceChart" />

                            <StackPanel Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Fx"
                                           Foreground="#2563EB" />
                                <TextBlock x:Name="TxtRightFx"
                                           Text="—"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="Fy"
                                           Foreground="#D97706" />
                                <TextBlock x:Name="TxtRightFy"
                                           Text="—"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8" />

                                <TextBlock Text="Fz"
                                           Foreground="#059669" />
                                <TextBlock x:Name="TxtRightFz"
                                           Text="—"
                                           FontSize="20"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Compact counters and logs -->
        <GroupBox Grid.Row="4" Header="运行统计与日志" Padding="8" Margin="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="接收字节" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock FontSize="18" FontWeight="SemiBold">
                        <Run x:Name="TxtByteCount" Text="0"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="有效帧" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock FontSize="18" FontWeight="SemiBold">
                        <Run x:Name="TxtFrameCount" Text="0"/>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="异常事件" Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#B91C1C">
                        <Run x:Name="TxtErrorCount" Text="0"/>
                    </TextBlock>
                </StackPanel>

                <TextBox Grid.Column="3"
                         x:Name="TxtLog"
                         IsReadOnly="True"
                         FontFamily="Consolas"
                         FontSize="11"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         AcceptsReturn="True"/>

                <Button Grid.Column="4"
                        x:Name="BtnClearLog"
                        Content="清空日志"
                        Click="BtnClearLog_Click"
                        Margin="8,0,0,0"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>