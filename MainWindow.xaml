<Window x:Class="ForcePlateDevTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KWFS02 起跑器诊断工具" Height="720" Width="1200"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="160"/>
        </Grid.RowDefinitions>

        <!-- Top: Connection & Collection Controls -->
        <GroupBox Grid.Row="0" Header="连接与采集控制" Padding="6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Connection Config -->
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock FontWeight="Bold" Margin="0,0,0,4">连接参数</TextBlock>
                    <UniformGrid Columns="2">
                        <TextBlock VerticalAlignment="Center" Margin="0,0,4,4">远端 IP:</TextBlock>
                        <TextBox x:Name="TxtRemoteIP" Text="192.168.1.101" Width="120" Margin="0,0,0,4"/>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,4,4">远端端口:</TextBlock>
                        <TextBox x:Name="TxtRemotePort" Text="5152" Width="120" Margin="0,0,0,4"/>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,4,4">本地 IP:</TextBlock>
                        <TextBox x:Name="TxtLocalIP" Text="192.168.1.100" Width="120" Margin="0,0,0,4"/>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,4,4">本地端口:</TextBlock>
                        <TextBox x:Name="TxtLocalPort" Text="8886" Width="120" Margin="0,0,0,4"/>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,4,4">站号地址:</TextBlock>
                        <TextBox x:Name="TxtStationAddr" Text="170" Width="120" Margin="0,0,0,4"/>
                        <TextBlock VerticalAlignment="Center" Margin="0,0,4,4">采集模式:</TextBlock>
                        <ComboBox x:Name="CmbMode" Width="120" Margin="0,0,0,4" SelectedIndex="1">
                            <ComboBoxItem Content="主动获取(49)"/>
                            <ComboBoxItem Content="被动接收(48)"/>
                            <ComboBoxItem Content="仅外部触发(58)"/>
                        </ComboBox>
                    </UniformGrid>
                </StackPanel>

                <!-- Connection Actions -->
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock FontWeight="Bold" Margin="0,0,0,4">连接操作</TextBlock>
                    <UniformGrid Columns="1">
                        <Button x:Name="BtnPing" Content="Ping" Click="BtnPing_Click" Margin="0,0,0,4" Width="100"/>
                        <Button x:Name="BtnConnect" Content="连接" Click="BtnConnect_Click" Margin="0,0,0,4" Width="100"/>
                        <Button x:Name="BtnDisconnect" Content="断开" Click="BtnDisconnect_Click" Margin="0,0,0,4" Width="100"/>
                        <TextBlock x:Name="TxtStatus" Text="未连接" Foreground="Gray" Margin="0,4,0,0" HorizontalAlignment="Center"/>
                    </UniformGrid>
                </StackPanel>

                <!-- Collection Actions -->
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock FontWeight="Bold" Margin="0,0,0,4">采集与指令</TextBlock>
                    <UniformGrid Columns="1">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button x:Name="BtnStart" Content="开始采集" Click="BtnStart_Click" Margin="0,0,4,0" Width="80"/>
                            <Button x:Name="BtnStop" Content="停止采集" Click="BtnStop_Click" Margin="0,0,4,0" Width="80"/>
                            <Button x:Name="BtnStartReceive" Content="仅接收" Click="BtnStartReceive_Click" Margin="0,0,0,0" Width="80"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,4,0">原始指令(HEX):</TextBlock>
                            <ComboBox x:Name="CmbPresetCmd" Width="150" Margin="0,0,4,0"
                                      SelectedIndex="0" SelectionChanged="CmbPresetCmd_SelectionChanged"
                                      ToolTip="选择常用指令自动填入右侧输入框">
                                <ComboBoxItem Content="开始采集 (48)" Tag="48 AA 0D 0A"/>
                                <ComboBoxItem Content="停止采集 (43)" Tag="43 AA 0D 0A"/>
                                <ComboBoxItem Content="主动轮询 (49)" Tag="49 AA 0D 0A"/>
                                <ComboBoxItem Content="仅外部触发 (58)" Tag="58 AA 0D 0A"/>
                                <ComboBoxItem Content="停止(长帧)" Tag="48 AA 00 00 00 00 00 00 00 00 00 00 00 0D 0A"/>
                            </ComboBox>
                            <TextBox x:Name="TxtRawCmd" Width="200" VerticalContentAlignment="Center"/>
                            <Button x:Name="BtnSendRaw" Content="发送" Click="BtnSendRaw_Click" Margin="4,0,0,0" Width="60"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                                已收字节: <Run x:Name="TxtByteCount" Text="0"/>
                            </TextBlock>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                                帧数: <Run x:Name="TxtFrameCount" Text="0"/>
                            </TextBlock>
                            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0">
                                错帧: <Run x:Name="TxtErrorCount" Text="0"/>
                            </TextBlock>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>

                <!-- Clear buttons -->
                <StackPanel Grid.Column="3">
                    <TextBlock FontWeight="Bold" Margin="0,0,0,4">数据视图</TextBlock>
                    <UniformGrid Columns="1">
                        <Button x:Name="BtnClearRaw" Content="清空原始字节" Click="BtnClearRaw_Click" Margin="0,0,0,4" Width="110"/>
                        <Button x:Name="BtnClearFrames" Content="清空解码帧" Click="BtnClearFrames_Click" Margin="0,0,0,4" Width="110"/>
                        <Button x:Name="BtnClearLog" Content="清空日志" Click="BtnClearLog_Click" Width="110"/>
                    </UniformGrid>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- Middle: Tabs for raw bytes and decoded frames -->
        <TabControl Grid.Row="1" Margin="0,8,0,8">
            <TabItem Header="原始字节流">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="TxtRawHeader" Text="等待数据..." Margin="4,2"/>
                    <TextBox Grid.Row="1" x:Name="TxtRawStream" IsReadOnly="True"
                             FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
            <TabItem Header="解码帧 (76B)">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="TxtFrameHeader" Text="等待帧..." Margin="4,2"/>
                    <DataGrid Grid.Row="1" x:Name="DgFrames" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="All"
                              HeadersVisibility="Column" FontFamily="Consolas" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="序号" Binding="{Binding Index}" Width="50"/>
                            <DataGridTextColumn Header="时间" Binding="{Binding Time}" Width="80"/>
                            <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="60"/>
                            <DataGridTextColumn Header="Fx(N)" Binding="{Binding Fx}" Width="80"/>
                            <DataGridTextColumn Header="Fy(N)" Binding="{Binding Fy}" Width="80"/>
                            <DataGridTextColumn Header="Fz(N)" Binding="{Binding Fz}" Width="80"/>
                            <DataGridTextColumn Header="原始数据" Binding="{Binding RawFloats}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom: Log -->
        <GroupBox Grid.Row="2" Header="日志" Padding="4">
            <TextBox x:Name="TxtLog" IsReadOnly="True"
                     FontFamily="Consolas" FontSize="11" VerticalScrollBarVisibility="Auto"
                     TextWrapping="Wrap"/>
        </GroupBox>
    </Grid>
</Window>